{
  "manifest_version": 3,
  "name": "スライド先生 Web 連携",
  "version": "0.1.0",
  "description": "スライド先生と Web アプリ（Google Colab など）をつなぎ、ページの部品を読み取って、ページの上に直接ハイライトを出します。",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["file:///*/index.html*", "file:///*/slide-sensei*.html*", "https://*.github.io/*"],
      "js": ["hub-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
